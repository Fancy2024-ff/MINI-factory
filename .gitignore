# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Node.js
node_modules/
generator/dist/
dashboard/dist/
apps/web/dist/
apps/web/.npm-cache/
core/generator/dist/
core/generator/.npm-cache/

# Environment
.env
agents/.env
*.local.env
.env.local

# Platform auth (real keys, never commit)
data/platform-auth/*.json
!data/platform-auth/*.json.example

# Data (generated at runtime)
data/apps/
data/prds/
data/projects/
data/reports/
data/outputs/
data/pipeline_state.json

# Task queue (SQLite; generated at runtime, never commit)
data/runtime/
data/tasks.sqlite3
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Opportunity crawl outputs (generated at runtime; keep scoring-config + example only)
data/opportunity/snapshots/
data/opportunity/market-snapshot.json
data/opportunity/candidate-pool.json
data/opportunity/feature-opportunities.json
data/opportunity/opportunity-queue.json
data/opportunity/opportunity-briefs.json
data/opportunity/crawl-report.json
data/opportunity/processed-apps.json
!data/opportunity/processed-apps.example.json

# QA build scratch (real npm install + build runs here, never commit)
**/.qa-build/
data/.tmp/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
.wrangler/
.claude/plans/
