# Mini-program Factory 环境配置
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，切勿提交真实 key）

# ── 运行环境 ────────────────────────────────────────────────
# development: 鉴权可选、热重载开启、绑定 127.0.0.1
# production:  必须设置 DASHBOARD_API_KEY，否则服务拒绝启动
APP_ENV=development

# ── 后端服务 (FastAPI) ──────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# Dashboard 与后端通信的 API Key。生产环境必填。
# 留空时仅在 development 下放行所有请求。
# ⚠️ Docker 部署注意：此值会在构建时 bake 进前端 JS bundle，更换后需重新 build dashboard image
DASHBOARD_API_KEY=
# 允许跨域的前端 origin（CORS）
DASHBOARD_ORIGIN=http://localhost:5173
# Pipeline 子进程超时（秒）
PIPELINE_TIMEOUT_SECONDS=600

# ── LLM 配置（可选，缺失时跳过 LLM 增强，不阻断生成）────────────
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.3

# ── 数据源 API (可选, 没有则用本地规则) ─────────────────────────
QIMAI_API_KEY=
SENSORTOWER_API_KEY=

# ── Node generator（非主链路，可选）─────────────────────────
# miniapp 生成主链路 = Python core/generator/codegen.py，不需要下面这些。
# 仅当你单独运行 Node generator 工具链（vitest / 本地实验）时才需要：
# GENERATOR_API_KEY=
# GENERATOR_OUTPUT_DIR=

# ── QA 构建超时（秒，可选）──────────────────────────────────
QA_INSTALL_TIMEOUT=180
QA_BUILD_TIMEOUT=180

# ── Telegram 自动部署 ─────────────────────────────────────────
# Bot Token（从 @BotFather 获取，首次需手动创建 bot）
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Cloudflare Pages（免费静态托管，自带 HTTPS）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PROJECT_NAME=miniforge-app
# CLOUDFLARE_ACCOUNT_ID=  # 可选，不填则自动检测

# ── 图片生成 provider（后端 core.integrations 使用；key 绝不下发前端/产物）──
# 用于 apps/api /api/generation/image 与 Telegram image bot。
IMAGE_GENERATION_ENDPOINT=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_PROVIDER=
IMAGE_GENERATION_TIMEOUT_SECONDS=60

# ── 生成产物前端运行时模式（codegen 注入进生成小程序的 src/config/api.ts）──
# GENERATION_MODE=mock（默认，本地闭环）| api（调真实后端）
# GENERATED_APP_API_BASE 须为 https 绝对域名，且加入小程序后台 request 合法域名
GENERATION_MODE=mock
GENERATED_APP_API_BASE=

# ── 小程序前端 AI API（部署后的 Mini App 用来调 AI）──────────────
WEBAPP_LLM_BASE_URL=https://api.deepseek.com
WEBAPP_LLM_API_KEY=
WEBAPP_LLM_MODEL=deepseek-chat

# ── 小程序平台凭证（上架用，可选）──────────────────────────────
WECHAT_APPID=
WECHAT_SECRET=
ALIPAY_APPID=
DOUYIN_APPID=
